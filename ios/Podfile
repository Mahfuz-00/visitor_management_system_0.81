# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# Pre-install: Force React pods to static if use_frameworks!
pre_install do |installer|
  installer.pod_targets.each do |pod|
    if pod.name.start_with?('ReactCommon', 'YogaKit') || pod.name.eql?('React-Codegen')
      def pod.build_type;
        Pod::BuildType.static_library
      end
    end
  end
end

target 'VMSNew' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # --- THE DEFINITIVE FIX FOR FMT STATIC ASSERTIONS ---
          
        # 1. Force C++20 for ALL React Native core components 
          # This fixes the 'contains' error in PerformanceObserver.cpp
          if target.name.start_with?('React') || 
             target.name.start_with?('RCT') || 
             target.name.include?('bridging')
            
            config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
            # This flag helps with C++20 compatibility on older SDK paths
            config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= ['$(inherited)']
            if !config.build_settings['OTHER_CPLUSPLUSFLAGS'].include?('-std=c++20')
              config.build_settings['OTHER_CPLUSPLUSFLAGS'] << '-std=c++20'
            end

          # 2. Keep the third-party troublemakers on C++17
          elsif target.name.include?('fmt') || target.name.include?('glog') || target.name.include?('Folly') || target.name.include?('boost')
            config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
            config.build_settings['OTHER_CPLUSPLUSFLAGS'] = ['$(inherited)'] # Clears the -fno-consteval
            
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'FMT_ENFORCE_COMPILE_STRING=0'
          end

          # --- END FIX ---

        # Ensure dSYM generation for Release builds
        if config.name == 'Release'
          config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
          config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'YES'
        end
      end
    end
  end
end